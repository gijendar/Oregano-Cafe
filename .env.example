# The Oregano Cafe - Render Deployment
# =====================================

# Server port (Render sets this automatically)
PORT=10000

# Supabase Configuration
# Get these from your Supabase project settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Note: SUPABASE_SERVICE_KEY is used server-side only.
# Do NOT expose this to browser-side JavaScript.
# The frontend uses the API routes which keep this key server-side.
